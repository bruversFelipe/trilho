# Use a DIFFERENT DB_NAME than production for local dev (same cluster is fine,
# just a different database) - otherwise test data ends up in the live app.
# Production (Railway) uses DB_NAME=trilho; local dev should use trilho_dev.
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?appName=trilho-dev
DB_NAME=trilho_dev
PORT=4000
JWT_SECRET=replace-with-a-long-random-string
